{
  "name": "ssd-ai-tester",
  "version": "0.8.0",
  "description": "Codex E2E skills with shared Playwright runtime, flexible workspaces and Thai BA/QA reports",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jsep09/SSS-Ai-Tester.git"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ssd-ai-tester": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "skills/",
    "install.ps1",
    "install.cmd",
    "README.md",
    "examples/",
    "scripts/",
    "test/",
    "CHANGELOG.md",
    "release.cmd"
  ],
  "scripts": {
    "postinstall": "node bin/postinstall.mjs",
    "test": "node --test test/*.test.mjs",
    "test:integration": "node scripts/verify-playwright.mjs",
    "pack:release": "node scripts/release.mjs",
    "release:check": "node scripts/check-release.mjs",
    "sync:release": "node scripts/sync-release.mjs",
    "release:dry-run": "node scripts/release-local.mjs --dry-run",
    "release": "node scripts/release-local.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "release:github": "release-it --config .release-it",
    "release:github:dry-run": "release-it --config .release-it --dry-run"
  },
  "devDependencies": {
    "release-it": "17.3.0",
    "@release-it/conventional-changelog": "8.0.1"
  }
}
